      "name": "2. GET /pet/findByStatus - Find pets by status",
      "description": "Positive and negative test cases for filtering pets by status.",
      "item": [
        {
          "name": "TC-GET-01 Find pets by status available",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-GET-01: Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC-GET-01: Response time < 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "pm.test(\"TC-GET-01: Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"TC-GET-01: Response body is a non-empty JSON array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "    pm.expect(json.length, \"number of results\").to.be.above(0);",
                  "});",
                  "pm.test(\"TC-GET-01: Every result has status 'available'\", function () {",
                  "    const json = pm.response.json();",
                  "    json.forEach(function (p) { pm.expect(p.status, \"status of pet \" + p.id).to.eql(\"available\"); });",
                  "});",
                  "pm.test(\"TC-GET-01: Every result has id and name\", function () {",
                  "    const json = pm.response.json();",
                  "    json.forEach(function (p) {",
                  "        pm.expect(p).to.have.property(\"id\");",
                  "        pm.expect(p).to.have.property(\"name\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
