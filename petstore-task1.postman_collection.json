    {
      "name": "1. POST /pet - Add a new pet",
      "description": "Positive and negative test cases for creating a pet.",
      "item": [
        {
          "name": "TC-POST-01 Create pet with valid data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"petName\", \"QA Test Dog \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-POST-01: Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC-POST-01: Response time < 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "pm.test(\"TC-POST-01: Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"TC-POST-01: Response contains a new numeric pet id\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json, \"response body\").to.have.property(\"id\");",
                  "    pm.expect(json.id, \"pet id\").to.be.a(\"number\").and.to.be.above(0);",
                  "    pm.collectionVariables.set(\"createdPetId\", json.id);",
                  "});",
                  "pm.test(\"TC-POST-01: Response echoes the submitted pet data\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.name).to.eql(pm.collectionVariables.get(\"petName\"));",
                  "    pm.expect(json.status).to.eql(\"available\");",
                  "    pm.expect(json.photoUrls).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(json.category.name).to.eql(\"QA-Dogs\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "description": "Expected: 200 with created pet JSON (new id > 0, data echoed). Note: spec documents no success response for this endpoint.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{petName}}\",\n  \"category\": {\n    \"id\": 101,\n    \"name\": \"QA-Dogs\"\n  },\n  \"photoUrls\": [\n    \"https://example.com/pet/qa-dog.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 1,\n      \"name\": \"qa-automation\"\n    }\n  ],\n  \"status\": \"available\"\n}",
              "options": {
